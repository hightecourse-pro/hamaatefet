# Copy to .env.local for local development (points at the STAGING Supabase project).
NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
# Outside production mail only reaches these (comma-separated; "@domain" allows a domain).
EMAIL_ALLOWLIST=you@example.com,@resend.dev
EMAIL_FROM=חד או פאן <noreply@opencode.org.il>
EMAIL_REPLY_TO=
RESEND_API_KEY=
CRON_SECRET=
